{
  "expo": {
    "name": "Wello",
    "slug": "wello",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#F6F2E9",
    "icon": "./assets/logo/wello-logo.png",
    "notification": {
      "icon": "./assets/logo/notification-icon.png",
      "color": "#0B2147"
    },
    "splash": {
      "image": "./assets/logo/wello-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F2E9"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.wellopartners.wello",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wello uses your location to show nearby businesses and offers.",
        "NSCameraUsageDescription": "Wello uses the camera to take photos of receipts and offers.",
        "NSPhotoLibraryUsageDescription": "Wello needs photo access to upload offer images."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/wello-logo.png",
        "backgroundColor": "#F6F2E9"
      },
      "package": "com.wellopartners.wello"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-image-picker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "0359ea52-8164-4fc8-bbc3-7b1ee9d1e5bb"
      }
    },
    "owner": "aihamh1"
  }
}
