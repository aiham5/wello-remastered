{
  "expo": {
    "name": "Wello",
    "slug": "wello",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#F6F2E9",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.aihamh1.wello",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Wello uses your location to show nearby businesses and offers.",
        "NSCameraUsageDescription": "Wello uses the camera to scan QR codes for offer redemption.",
        "NSPhotoLibraryUsageDescription": "Wello needs photo access to upload offer images."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.aihamh1.wello"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "0359ea52-8164-4fc8-bbc3-7b1ee9d1e5bb"
      }
    },
    "owner": "aihamh1"
  }
}
