{
  "expo": {
    "name": "Wello",
    "slug": "wello",
    "scheme": "wello",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#FFF03B",
    "icon": "./assets/logo/app-icon.png",
    "notification": {
      "icon": "./assets/logo/notification-icon.png",
      "color": "#0B2147"
    },
    "splash": {
      "image": "./assets/logo/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF03B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.wellopartners.wello",
      "icon": "./assets/logo/app-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Wello uses your location to show nearby businesses and offers.",
        "NSCameraUsageDescription": "Wello uses the camera to take photos of receipts and offers.",
        "NSPhotoLibraryUsageDescription": "Wello needs photo access to upload offer images."
      },
      "buildNumber": "4",
      "associatedDomains": [
        "applinks:www.wellopartners.com"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "icon": "./assets/logo/app-icon.png",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/logo.png",
        "backgroundColor": "#FFF03B"
      },
      "package": "com.wellopartners.wello",
      "notification": {
        "icon": "./assets/logo/notification-icon.png",
        "color": "#0B2147"
      },
      "googleServicesFile": "./google-services.json",
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-font",
      "expo-camera",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo/notification-icon.png",
          "color": "#0B2147"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0359ea52-8164-4fc8-bbc3-7b1ee9d1e5bb"
      }
    },
    "owner": "aihamh1",
    "updates": {
      "url": "https://u.expo.dev/0359ea52-8164-4fc8-bbc3-7b1ee9d1e5bb"
    }
  }
}
